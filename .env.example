# Local ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development database
POSTGRES_DB=stock_market_analyzer
POSTGRES_USER=stock_market_analyzer
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL=postgresql+psycopg://stock_market_analyzer:replace-with-local-only-password@localhost:5432/stock_market_analyzer
INSTRUMENT_SEARCH_LIMIT=20

# Disposable cache
REDIS_URL=redis://localhost:6379/0

# Frontend API target
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
